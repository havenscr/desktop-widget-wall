{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "https://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Widget Wall",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "open": "^((mailto:\\w+)|(tel:\\w+)|(https?://\\w+)|(ms-clock://\\w+)).+"
      },
      "window": {
        "all": true
      },
      "fs": {
        "readDir": true,
        "readFile": true,
        "scope": [
          "$APPDATA/Microsoft/Windows/Recent/**",
          "$HOME/.claude/**"
        ]
      }
    },
    "bundle": {
      "active": true,
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico"
      ],
      "identifier": "com.havens-consulting.widget-wall",
      "targets": "all",
      "windows": {
        "webviewInstallMode": {
          "type": "embedBootstrapper"
        }
      }
    },
    "security": {
      "csp": null
    },
    "systemTray": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false
    },
    "windows": [
      {
        "title": "Widget Wall",
        "width": 2304,
        "height": 648,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true
      }
    ]
  }
}
