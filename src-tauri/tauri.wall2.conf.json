{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Widget Wall 2",
  "version": "0.1.0",
  "identifier": "com.havens-consulting.widget-wall2",
  "build": {
    "beforeDevCommand": "npm --prefix wall run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm --prefix wall ci && npm --prefix wall run build",
    "frontendDist": "../wall/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Widget Wall 2",
        "width": 2560,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": false,
        "useHttpsScheme": true
      }
    ]
  }
}
