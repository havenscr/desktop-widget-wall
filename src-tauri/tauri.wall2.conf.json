{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Widget Wall 2",
  "version": "0.1.0",
  "identifier": "com.havens-consulting.widget-wall2",
  "build": {
    "beforeDevCommand": "npm --prefix wall run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm --prefix wall ci && npm --prefix wall run build",
    "frontendDist": "../wall/dist"
  },
  "app": {
    "windows": [
      {
        "label": "wall2",
        "title": "Widget Wall 2",
        "width": 2560,
        "height": 720,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "alwaysOnTop": false,
        "useHttpsScheme": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["wall2"],
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https://api.open-meteo.com",
        "base-uri": "'none'",
        "form-action": "'none'",
        "object-src": "'none'"
      },
      "devCsp": {
        "default-src": "'none'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https://api.open-meteo.com http://localhost:1421 ws://localhost:1421",
        "base-uri": "'none'",
        "form-action": "'none'",
        "object-src": "'none'"
      }
    }
  }
}
