{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ridgeline",
  "version": "0.1.0",
  "identifier": "com.havens-consulting.widget-wall2",
  "build": {
    "beforeDevCommand": "npm --prefix wall run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm --prefix wall ci && npm --prefix wall run build",
    "frontendDist": "../wall/dist"
  },
  "bundle": {
    "icon": [
      "icons-ridgeline/32x32.png",
      "icons-ridgeline/128x128.png",
      "icons-ridgeline/128x128@2x.png",
      "icons-ridgeline/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "45c8f91e-8224-55fe-92ae-75e0e555cffa"
      },
      "nsis": {
        "installerHooks": "ridgeline-installer-hooks.nsh"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "wall2",
        "title": "Ridgeline",
        "width": 2560,
        "height": 720,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "alwaysOnTop": false,
        "useHttpsScheme": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["wall2"],
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: https://i.scdn.co https://mosaic.scdn.co https://image-cdn-ak.spotifycdn.com",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https://api.open-meteo.com",
        "frame-src": "https://www.youtube-nocookie.com https://player.twitch.tv",
        "frame-ancestors": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "object-src": "'none'"
      },
      "devCsp": {
        "default-src": "'none'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https://i.scdn.co https://mosaic.scdn.co https://image-cdn-ak.spotifycdn.com",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https://api.open-meteo.com http://localhost:1421 ws://localhost:1421",
        "frame-src": "https://www.youtube-nocookie.com https://player.twitch.tv",
        "frame-ancestors": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "object-src": "'none'"
      }
    }
  }
}
