{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Widget Wall 2",
  "version": "0.1.0",
  "identifier": "com.havens-consulting.widget-wall2",
  "build": {
    "beforeDevCommand": "npm --prefix wall run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm --prefix wall ci && npm --prefix wall run build",
    "frontendDist": "../wall/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Widget Wall 2",
        "width": 2560,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "alwaysOnTop": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https://api.open-meteo.com",
        "base-uri": "'none'",
        "form-action": "'none'",
        "object-src": "'none'"
      }
    }
  }
}
